TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_RECV_WINDOW=5000

# Comma-separated list of ad IDs that should be updated every cycle.
BYBIT_BTC_NGN_AD_IDS=

# Price model: NGN per BTC = (BTCUSDT * USDNGN) * multiplier + offset
PRICE_MULTIPLIER=1.0
PRICE_OFFSET=0

# Exchange-rate API used for USDNGN (free endpoint).
FX_API_URL=https://open.er-api.com/v6/latest/USD

# HTTP server port (Render injects PORT automatically)
PORT=10000

# Polling interval in seconds
UPDATE_INTERVAL_SECONDS=60

# Set to 1 only if you want health endpoint without Telegram polling
DISABLE_BACKGROUND_BOT=0
